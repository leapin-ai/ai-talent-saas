<!-- subject -->
{{ subjectText }}
<!-- html -->
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Role Readiness Questionnaire</title>
    <style>
        @media only screen and (max-width: 480px) {
            .mail-outer { padding: 16px 10px !important; }
            .mail-pad { padding: 20px 16px !important; }
        }
    </style>
</head>
<body style="margin:0;padding:0;background-color:{{ themeTint }};" bgcolor="{{ themeTint }}">
<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ themeTint }}" style="background-color:{{ themeTint }};background-image:linear-gradient(180deg,{{ themeLight }} 0%,{{ themeTint }} 320px,#F7F7F9 100%);">
    <tr>
        <td align="center" class="mail-outer" style="padding:40px 16px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#1F1F1F;">
                <tr>
                    <td bgcolor="{{ themeColor }}" style="background-color:{{ themeColor }};background-image:linear-gradient(135deg,{{ themeColor }} 0%,{{ themeDark }} 100%);border-radius:16px 16px 0 0;padding:28px 28px 26px;" class="mail-pad">
                        <table cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td{% if logoUrl == blank %} bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:10px;padding:6px 10px;"{% endif %}>
                                    {% if logoUrl != blank %}<img src="{{ logoUrl }}" alt="{{ companyName }}" height="28" style="display:block;height:28px;max-width:140px;border:0;">{% else %}<span style="display:block;height:28px;line-height:28px;font-size:16px;font-weight:700;color:{{ themeColor }};">{{ companyInitial }}</span>{% endif %}
                                </td>
                                <td style="padding-left:12px;font-size:14px;font-weight:600;color:#FFFFFF;">{{ companyName }}</td>
                            </tr>
                        </table>
                        <div style="margin-top:22px;font-size:24px;line-height:32px;font-weight:700;color:#FFFFFF;">Role Readiness Questionnaire</div>
                        <div style="margin-top:6px;font-size:14px;line-height:22px;color:{{ themeLight }};">{{ itemsCount }} role{{ itemsPlural }} · Fill in without signing in</div>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:0 0 16px 16px;padding:28px;" class="mail-pad">
                        <div style="font-size:14px;line-height:22px;color:#595959;margin:0 0 20px;">Hello, {{ companyOrWe }} invites you to fill in the readiness questionnaires for the roles below. Your answers help assess how AI is reshaping each role and how ready the team is.</div>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            {{ itemsHtml | raw }}
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                            <tr>
                                <td bgcolor="#FAFAFA" style="background-color:#FAFAFA;border-radius:10px;padding:12px 14px;font-size:12px;line-height:20px;color:#8C8C8C;">
                                    Questionnaire links are valid until <span style="color:#595959;font-weight:600;">{{ expiresText }}</span>. For the recipient only; please do not forward.
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:20px 8px 0;font-size:12px;line-height:20px;color:#8C8C8C;">Sent by {{ companyOrBrand }}. Please do not reply to this email.</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
<!-- signature -->
LeapIn
<!-- text -->
Hello, {{ companyOrWe }} invites you to fill in the readiness questionnaires for the following {{ itemsCount }} role{{ itemsPlural }}:
{{ itemsText }}
Questionnaire links are valid until {{ expiresText }}. For the recipient only; please do not forward.

{{ companyName }}
