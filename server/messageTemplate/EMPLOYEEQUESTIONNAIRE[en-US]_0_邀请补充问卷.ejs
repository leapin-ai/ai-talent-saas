<!-- subject -->
<%= subject || ((companyName || tenantName) + ' | Questionnaire: ' + projectName) %>
<!-- html -->
<html>
<head>
    <meta charset="utf-8">
    <title>Questionnaire Invitation</title>
    <style>
        .container {
            max-width: 600px;
            margin: 0 auto;
            font-family: Arial, sans-serif;
            color: #1f2937;
            line-height: 1.6;
        }

        .header {
            background: <%= themeColor %>;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .content {
            padding: 28px 24px;
            background: #f9f9f9;
        }

        .content p {
            margin: 0 0 14px;
        }

        .cta {
            margin: 24px 0;
        }

        .cta a {
            display: inline-block;
            padding: 12px 20px;
            background: <%= themeColor %>;
            color: #fff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
        }

        .link {
            word-break: break-all;
            margin-top: 12px;
            font-size: 12px;
            color: #64748b;
        }

        .footer {
            margin-top: 20px;
            color: #64748b;
            font-size: 13px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1 style="margin:0;font-size:20px;"><%= projectName %></h1>
    </div>
    <div class="content">
        <p>Dear <%= name %>,</p>
        <p>As part of the <%= companyName || tenantName %> Workforce Readiness program, we invite you to complete the questionnaire "<%= projectName %>".</p>
        <p>Your answers will help complete your talent profile and role readiness analysis.</p>
        <p>Please complete it<% if (deadlineText) { %> by <strong><%= deadlineText %></strong><% } %>.</p>
        <div class="cta">
            <a href="<%= inviteUrl %>" target="_blank">Start Questionnaire</a>
        </div>
        <div class="link">If the button does not work, copy this link into your browser:<br/><a href="<%= inviteUrl %>" target="_blank" style="color: <%= themeColor %>;"><%= inviteUrl %></a></div>
        <% if (contactEmail) { %>
        <p class="footer">If you have any questions, please contact <a href="mailto:<%= contactEmail %>" style="color: <%= themeColor %>;"><%= contactEmail %></a>.</p>
        <% } %>
        <p class="footer">Thank you for your participation.</p>
        <p class="footer" style="margin-bottom:0;"><%= teamName || companyName || tenantName %></p>
    </div>
</div>
</body>
</html>
<!-- signature -->
LeapIn
<!-- text -->
