<!-- html -->
<html>
<head>
    <meta charset="utf-8">
    <title>LeapIn Talent SaaS Reset Password</title>
    <style>
        .container {
            max-width: 600px;
            margin: 0 auto;
            font-family: Arial, sans-serif;
        }

        .header {
            background: #2A5CAA;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .content {
            padding: 25px;
            background: #f9f9f9;
        }

        .code {
            font-size: 28px;
            letter-spacing: 5px;
            background: #fff;
            padding: 15px;
            text-align: center;
            margin: 20px 0;
            border: 1px dashed #2A5CAA;
            color: #2A5CAA;
        }

        .warning {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            padding: 12px;
