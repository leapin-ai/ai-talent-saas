<!-- subject -->
<%= subject || ((companyName ? companyName + ' ' : '') + '岗位洞察报告分享') %>
<!-- html -->
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>岗位洞察报告</title>
</head>
<body style="margin:0;padding:0;background-color:<%= themeTint %>;" bgcolor="<%= themeTint %>">
<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="<%= themeTint %>" style="background-color:<%= themeTint %>;background-image:linear-gradient(180deg,<%= themeLight %> 0%,<%= themeTint %> 320px,#F7F7F9 100%);">
    <tr>
        <td align="center" style="padding:40px 16px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',Arial,sans-serif;color:#1F1F1F;">
                <tr>
                    <td bgcolor="<%= themeColor %>" style="background-color:<%= themeColor %>;background-image:linear-gradient(135deg,<%= themeColor %> 0%,<%= themeDark %> 100%);border-radius:16px 16px 0 0;padding:28px 28px 26px;">
                        <table cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td<% if (!logoUrl) { %> bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:10px;padding:6px 10px;"<% } %>>
                                    <% if (logoUrl) { %><img src="<%= logoUrl %>" alt="<%= companyName %>" height="28" style="display:block;height:28px;max-width:140px;border:0;"><% } else { %><span style="display:block;height:28px;line-height:28px;font-size:16px;font-weight:700;color:<%= themeColor %>;"><%= (companyName || '·').slice(0, 1) %></span><% } %>
                                </td>
                                <td style="padding-left:12px;font-size:14px;font-weight:600;color:#FFFFFF;"><%= companyName %></td>
                            </tr>
                        </table>
                        <div style="margin-top:22px;font-size:24px;line-height:32px;font-weight:700;color:#FFFFFF;">岗位洞察报告</div>
                        <div style="margin-top:6px;font-size:14px;line-height:22px;color:<%= themeLight %>;">共 <%= items.length %> 个岗位 · 点击即可免登录查看</div>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:0 0 16px 16px;padding:28px;">
                        <div style="font-size:14px;line-height:22px;color:#595959;margin:0 0 20px;">您好，<%= companyName || '我们' %> 与您分享了以下岗位的洞察报告，包含岗位受 AI 影响的变化趋势与团队就绪情况。</div>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <% items.forEach(function (item, index) { %>
                            <% if (index > 0) { %><tr><td height="12" style="height:12px;font-size:0;line-height:0;">&nbsp;</td></tr><% } %>
                            <tr>
                                <td bgcolor="<%= themeTint %>" style="background-color:<%= themeTint %>;border:1px solid <%= themeBorder %>;border-radius:12px;padding:16px;">
                                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="44" valign="middle">
                                                <div style="width:44px;height:44px;line-height:44px;border-radius:12px;background-color:<%= themeColor %>;color:#FFFFFF;text-align:center;font-size:18px;font-weight:600;"><%= (item.name || '-').slice(0, 1) %></div>
                                            </td>
                                            <td valign="middle" style="padding:0 12px;">
                                                <div style="font-size:16px;font-weight:600;line-height:24px;color:#1F1F1F;"><%= item.name %></div>
                                                <% if (item.department) { %><div style="margin-top:4px;"><span style="display:inline-block;padding:1px 10px;border-radius:999px;background-color:#FFFFFF;border:1px solid <%= themeBorder %>;color:<%= themeColor %>;font-size:12px;line-height:20px;"><%= item.department %></span></div><% } %>
                                            </td>
                                            <td width="104" align="right" valign="middle">
                                                <table cellpadding="0" cellspacing="0" border="0">
                                                    <tr>
                                                        <td bgcolor="<%= themeColor %>" style="background-color:<%= themeColor %>;border-radius:999px;">
                                                            <a href="<%= item.url %>" target="_blank" style="display:inline-block;padding:8px 18px;color:#FFFFFF;font-size:13px;font-weight:600;line-height:20px;text-decoration:none;white-space:nowrap;">查看报告</a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <% }) %>
                        </table>
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                            <tr>
                                <td bgcolor="#FAFAFA" style="background-color:#FAFAFA;border-radius:10px;padding:12px 14px;font-size:12px;line-height:20px;color:#8C8C8C;">
                                    链接有效期至 <span style="color:#595959;font-weight:600;"><%= expiresText %></span>，仅供收件人查看，请勿转发。
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:20px 8px 0;font-size:12px;line-height:20px;color:#8C8C8C;">此邮件由 <%= companyName || 'LeapIn' %> 发送，请勿直接回复。</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
<!-- signature -->
LeapIn
<!-- text -->
您好，<%= companyName || '我们' %> 与您分享了以下 <%= items.length %> 个岗位的洞察报告：
<% items.forEach(function (item) { %>
<%= item.name %><% if (item.department) { %>（<%= item.department %>）<% } %>
查看报告：<%= item.url %>
<% }) %>
链接有效期至 <%= expiresText %>，仅供收件人查看，请勿转发。

<%= companyName %>
